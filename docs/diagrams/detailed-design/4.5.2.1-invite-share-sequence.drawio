        </mxCell>
        <mxCell id="m1" value="POST /api/folders/{id}/shares { friendUserId, permission }" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0806;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act0">
