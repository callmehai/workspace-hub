        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="fe">
          <mxGeometry x="45" y="90" width="10" height="670" as="geometry"/>
