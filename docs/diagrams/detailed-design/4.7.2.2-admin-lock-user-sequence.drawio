        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="repo">
          <mxGeometry x="45" y="300" width="10" height="50" as="geometry"/>
