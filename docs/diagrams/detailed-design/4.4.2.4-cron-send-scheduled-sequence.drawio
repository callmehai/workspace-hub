        <mxCell id="m0" value="POST /api/internal/process-scheduled  (header X-Cron-Secret)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0918;entryX=0;entryY=0.0;" edge="1" parent="1" source="cron" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note1" value="ValidateCronSecret: FixedTimeEquals với Cron:Secret — sai/thiếu → 401&#xa;(CsrfMiddleware bỏ qua path này)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="160" width="230" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="ProcessDueEmailsAsync(maxBatch = 50)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1375;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="GetPendingDueEmailsAsync(utcNow, 50)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0862;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="SELECT WHERE Status=Pending AND SendAt&lt;=now ORDER BY SendAt" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0725;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
