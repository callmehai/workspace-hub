          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="loop: lấy connection (cache) + DecodeAttachments(base64)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3448;entryX=1;entryY=0.3966;" edge="1" parent="1" source="act2" target="act2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="730" y="440"/><mxPoint x="730" y="470"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note7" value="connection null / không Gmail / không Active → MarkFailed(Status=Failed, RetryCount++, LastError)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="690" y="490" width="230" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="SendMessageAsync(conn, ...)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.569;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="users.messages.send" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.122;entryX=0;entryY=0.0;" edge="1" parent="1" source="act5" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="messageId → Status = Sent, SentAt = UtcNow" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.7414;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="SaveChangesAsync (một lần cho cả batch)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.8276;entryX=0;entryY=0.6232;" edge="1" parent="1" source="act2" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="UPDATE ScheduledEmails" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6957;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m13" value="ProcessScheduledResult(total, sent, failed)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8625;" edge="1" parent="1" source="act2" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note14" value="Fail → Status = Failed; cron chỉ quét Pending ⇒ KHÔNG auto-retry lượt sau" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="690" y="850" width="230" height="40" as="geometry"/>
