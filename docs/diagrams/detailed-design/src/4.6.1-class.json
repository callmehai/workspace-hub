   "color": "purple",
   "methods": [
    "+ NotifyNewItemsAsync(connectionId, userId,",
    "    beforeExternalIds, ct)"
   ]
  },
  {
   "id": "ihc",
   "name": "INotificationHubClient",
   "stereotype": "interface",
   "col": 3,
   "row": 1,
