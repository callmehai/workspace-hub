    "+ ReceiveNotification(notification: NotificationDto)"
   ]
  },
  {
   "id": "ics",
   "name": "ImportantContactService",
   "stereotype": "service",
   "col": 0,
   "row": 2,
   "color": "green",
   "attrs": [
    "- _repo: IImportantContactRepository"
   ],
   "methods": [
    "+ CreateAsync: trim Identifier → ExistsAsync",
    "   trùng → ConflictException 409",
    "+ DeleteAsync: GetByIdAndUserAsync ?? 404",
    "- static Map(contact): ImportantContactResponse"
   ]
  },
  {
   "id": "ns",
   "name": "NotificationService",
   "stereotype": "service",
   "col": 1,
   "row": 2,
   "color": "green",
   "attrs": [
    "- _notifications: INotificationRepository",
    "- _publisher: INotificationPublisher"
   ],
   "methods": [
    "+ CreateAndSendAsync: insert DB → MapToDto",
    "   → _publisher.PublishToUserAsync(userId, dto)",
    "+ MarkAsReadAsync: GetByIdForUserAsync ?? 404",
    "   chỉ save khi !IsRead (không publish)",
    "+ MarkAllAsReadAsync: bulk update (không publish)"
   ]
  },
  {
   "id": "sins",
   "name": "SyncItemNotificationService",
   "stereotype": "service",
   "col": 2,
   "row": 2,
   "color": "green",
   "attrs": [
    "- _items: IItemRepository",
    "- _notifications: INotificationService",
    "maxPerSync = 10"
   ],
   "methods": [
    "+ NotifyNewItemsAsync: diff ExternalId sau/trước sync",
    "   bỏ email có label TRASH / SPAM",
    "   > 10 item → chỉ lấy IsImportant, tối đa 10",
    "   Email + IsImportant → ImportantEmail, còn lại ItemSynced",
    "- BuildPayload(item) → (titleKey, bodyJson)"
   ]
  },
  {
   "id": "pub",
   "name": "SignalRNotificationPublisher",
   "stereotype": "infrastructure",
   "col": 3,
   "row": 2,
   "color": "orange",
   "attrs": [
    "- _hub: IHubContext<NotificationHub, INotificationHubClient>"
   ],
   "methods": [
    "+ PublishToUserAsync(userId, dto, ct)",
    "   → Clients.User(userId).ReceiveNotification(dto)",
    "+ PublishToUsersAsync(userIds, dto, ct)",
    "   (map theo user, KHÔNG dùng group)"
   ]
  },
  {
   "id": "icrepo",
   "name": "IImportantContactRepository",
   "stereotype": "repository",
   "col": 0,
   "row": 3,
   "color": "orange",
   "methods": [
    "+ GetIdentifiersAsync(userId, type, ct)",
    "+ GetByUserAsync(userId, type?, ct)",
    "+ ExistsAsync(userId, type, identifier, ct)",
    "+ GetByIdAndUserAsync(id, userId, ct)"
   ]
  },
  {
   "id": "nrepo",
   "name": "INotificationRepository",
   "stereotype": "repository",
   "col": 1,
   "row": 3,
   "color": "orange",
   "methods": [
    "+ GetByUserId(userId): IQueryable<Notification>",
    "+ GetByIdForUserAsync(userId, id, ct)",
    "+ MarkAllAsReadAsync(userId, ct)  (bulk)",
    "+ AddAsync / AddRangeAsync / SaveChangesAsync"
   ]
  },
  {
   "id": "mapper",
   "name": "GmailItemMapper",
   "stereotype": "mapper",
   "col": 2,
   "row": 3,
   "color": "green",
   "methods": [
    "+ ToItem(message, userId, connectionId, importantEmails)",
    "   parse From bằng MailAddress",
    "   importantEmails.Contains(addr) → Item.IsImportant = true",
    "   (chỉ set lúc TẠO item; re-sync không đụng lại)"
   ]
  },
  {
   "id": "fehook",
   "name": "FE — hooks/notificationHub",
   "stereotype": "frontend",
   "col": 3,
   "row": 3,
   "color": "grey",
   "attrs": [
    "notificationHubManager (@microsoft/signalr)",
    "  withCredentials + CSRF + autoReconnect",
    "useNotificationHub → subscribe"
   ],
   "methods": [
    "on('ReceiveNotification') → applyIncomingNotification",
    "  dedupe id → tăng unreadCount → prepend list",
    "  invalidate items nếu type ∈ INBOX_REFRESH",
    "  → showNotificationToast(title, subtitle, onClick)"
   ]
  },
