{
  "title": "4.4.2 Sequence — Email Workspace (gửi ngay · hẹn giờ · cron gửi)",
  "participants": [
    {"id":"u","label":"User","actor":true},
    {"id":"fe","label":"Frontend SPA"},
    {"id":"ec","label":"EmailsController"},
    {"id":"ses","label":"SendEmailService"},
    {"id":"sc","label":"ScheduledEmail\nCommandsController"},
    {"id":"ss","label":"ScheduledEmailsService"},
    {"id":"cron","label":"Cron\n(X-Cron-Secret)"},
    {"id":"intc","label":"InternalController"},
    {"id":"pss","label":"ProcessScheduled\nEmailsService"},
    {"id":"gw","label":"IGmailGateway"},
    {"id":"gmail","label":"Gmail API"},
    {"id":"repo","label":"Repositories"},
    {"id":"db","label":"SQL Server"}
  ],
  "messages": [
    {"note":"A. Gửi ngay — POST /api/emails/send", "over":"ec"},
    {"from":"u","to":"fe","label":"soạn email + đính kèm file"},
    {"from":"fe","to":"ec","label":"POST /api/emails/send { connectionId, to, cc, subject, bodyHtml, attachments[] }"},
    {"note":"SendEmailRequestValidator + RequestSizeLimit 40 MB", "over":"ec"},
    {"from":"ec","to":"ses","label":"SendAsync(userId, request)"},
    {"from":"ses","to":"repo","label":"GetByIdTrackedAsync(connectionId)"},
    {"from":"repo","to":"ses","label":"connection","return":true},
    {"note":"UserId lệch → 404 (che tồn tại)\nServiceType != Gmail hoặc Status != Active → 400", "over":"ses"},
    {"from":"ses","to":"gw","label":"SendMessageAsync(conn, to, cc, bcc, subject, html, attachments)"},
    {"from":"gw","to":"gmail","label":"users.messages.send (MIME RFC 2822, From = ProviderAccountId)"},
    {"from":"gmail","to":"gw","label":"messageId","return":true},
    {"from":"gw","to":"ses","label":"messageId","return":true},
    {"from":"ses","to":"ec","label":"SendEmailResult(messageId, sentAt)","return":true},
    {"from":"ec","to":"fe","label":"200 OK","return":true},
    {"note":"Không tạo Item ngay — email xuất hiện ở Inbox\nsau lần GmailSync kế tiếp", "over":"ses"},

    {"note":"B. Hẹn giờ gửi — POST /api/scheduled-emails", "over":"sc"},
    {"from":"u","to":"fe","label":"chọn thời điểm gửi"},
    {"from":"fe","to":"sc","label":"POST /api/scheduled-emails { ..., sendAt }"},
    {"from":"sc","to":"ss","label":"CreateAsync(userId, request)"},
    {"from":"ss","to":"repo","label":"load connection → check UserId + ServiceType == Gmail"},
    {"from":"ss","to":"repo","label":"AddAsync(ScheduledEmail{ Status = Pending, AttachmentsJson = base64 })"},
    {"from":"repo","to":"db","label":"INSERT ScheduledEmails"},
    {"from":"ss","to":"sc","label":"ScheduledEmailDto","return":true},
    {"from":"sc","to":"fe","label":"201 Created","return":true},

    {"note":"C. Cron gửi email đến hạn — POST /api/internal/process-scheduled", "over":"intc"},
    {"from":"cron","to":"intc","label":"POST /api/internal/process-scheduled  (header X-Cron-Secret)"},
    {"note":"ValidateCronSecret: FixedTimeEquals với Cron:Secret\nsai/thiếu → 401 (CsrfMiddleware bỏ qua path này)", "over":"intc"},
    {"from":"intc","to":"pss","label":"ProcessDueEmailsAsync(maxBatch = 50)"},
    {"from":"pss","to":"repo","label":"GetPendingDueEmailsAsync(utcNow, 50)"},
    {"from":"repo","to":"db","label":"SELECT … WHERE Status = Pending AND SendAt <= now ORDER BY SendAt"},
    {"from":"db","to":"repo","label":"danh sách email đến hạn","return":true},
    {"from":"repo","to":"pss","label":"due[]","return":true},
    {"from":"pss","to":"pss","label":"loop: lấy connection (cache trong 1 lượt) + DecodeAttachments"},
    {"note":"connection null / không Gmail / không Active\n→ MarkFailed(Status = Failed, RetryCount++, LastError)", "over":"pss"},
    {"from":"pss","to":"gw","label":"SendMessageAsync(conn, …)"},
    {"from":"gw","to":"gmail","label":"users.messages.send"},
    {"from":"gmail","to":"gw","label":"messageId","return":true},
    {"from":"gw","to":"pss","label":"OK → Status = Sent, SentAt = UtcNow","return":true},
    {"from":"pss","to":"repo","label":"SaveChangesAsync (một lần cho cả batch)"},
    {"from":"repo","to":"db","label":"UPDATE ScheduledEmails"},
    {"from":"pss","to":"intc","label":"ProcessScheduledResult(total, sent, failed)","return":true},
    {"from":"intc","to":"cron","label":"200 { total, sent, failed }","return":true},
    {"from":"fe","to":"u","label":"trang Scheduled Emails hiển thị trạng thái Sent / Failed","return":true}
  ]
}
