{
  "title": "4.5.2 Sequence — Folder Sharing (mời · chấp nhận · viewer đọc item Drive con)",
  "participants": [
    {"id":"a","label":"Owner A","actor":true},
    {"id":"b","label":"Viewer B","actor":true},
    {"id":"fe","label":"Frontend SPA"},
    {"id":"fc","label":"FoldersController"},
    {"id":"fs","label":"FolderService"},
    {"id":"ns","label":"NotificationService\n+ SignalR"},
    {"id":"is","label":"ItemService /\nDriveContentService"},
    {"id":"perm","label":"IFolderRepository\n(share-check)"},
    {"id":"conn","label":"IConnectionRepository"},
    {"id":"gw","label":"IDriveGateway"},
    {"id":"google","label":"Google Drive API"},
    {"id":"db","label":"SQL Server"}
  ],
  "messages": [
    {"note":"A. Owner A mời B vào folder — POST /api/folders/{id}/shares", "over":"fc"},
    {"from":"a","to":"fe","label":"chọn bạn bè + quyền (Viewer / Editor)"},
    {"from":"fe","to":"fc","label":"POST /api/folders/{id}/shares { friendUserId, permission }"},
    {"from":"fc","to":"fs","label":"InviteShareAsync(folderId, requestingUserId = A, request)"},
    {"from":"fs","to":"perm","label":"GetByIdWithOwnerAsync(folderId)"},
    {"note":"folder.OwnerId != A → ForbiddenException 403\nfriendUserId == A → BusinessRuleException 400", "over":"fs"},
    {"from":"fs","to":"db","label":"GetBetweenAsync(A, B) → Friendship.Status"},
    {"note":"không phải bạn bè (Accepted) → BusinessRuleException\nShareExistsAsync → ConflictException 409", "over":"fs"},
    {"from":"fs","to":"perm","label":"AddShareAsync(FolderShare{ Permission, AcceptedAt = null }) + Save"},
    {"from":"perm","to":"db","label":"INSERT FolderShares"},
    {"from":"fs","to":"ns","label":"CreateAndSendAsync(B, ShareInvite, …)  (best-effort)"},
    {"from":"ns","to":"b","label":"toast realtime \"A đã chia sẻ folder …\"","async":true},
    {"from":"fs","to":"fc","label":"FolderShareDto (Status = Pending)","return":true},
    {"from":"fc","to":"fe","label":"201 Created","return":true},

    {"note":"B. B chấp nhận lời mời", "over":"fc"},
    {"from":"b","to":"fe","label":"mở trang Shared with me"},
    {"from":"fe","to":"fc","label":"GET /api/folders/shared-with-me"},
    {"from":"fc","to":"fs","label":"GetFoldersSharedWithMeAsync(B)"},
    {"from":"fs","to":"perm","label":"GetSharesForUserAsync(B)"},
    {"from":"fs","to":"fc","label":"SharedFolderDto[] (Status = Pending | Accepted)","return":true},
    {"from":"fe","to":"fc","label":"POST /api/folders/shares/{shareId}/accept"},
    {"from":"fc","to":"fs","label":"AcceptShareAsync(shareId, B)"},
    {"note":"share.SharedWithUserId != B → 403\nđã accept → 409", "over":"fs"},
    {"from":"fs","to":"perm","label":"share.AcceptedAt = UtcNow + SaveChangesAsync"},
    {"from":"perm","to":"db","label":"UPDATE FolderShares"},
    {"from":"fc","to":"fe","label":"200 OK","return":true},

    {"note":"C. B mở folder được share và đọc file Drive con", "over":"is"},
    {"from":"b","to":"fe","label":"mở folder được chia sẻ"},
    {"from":"fe","to":"is","label":"GET /api/items?folderId={id}"},
    {"from":"is","to":"perm","label":"ExistsByOwnerAsync(folderId, B) → false"},
    {"from":"is","to":"perm","label":"GetShareByFolderAndUserAsync(folderId, B)"},
    {"note":"share == null hoặc AcceptedAt == null\n⇒ trả PagedResult RỖNG (không 403)", "over":"is"},
    {"from":"is","to":"db","label":"GetPagedAsync(targetOwnerId = A, folderId, …)"},
    {"from":"db","to":"is","label":"items của A","return":true},
    {"from":"is","to":"fe","label":"200 PagedResult<ItemResponse> (IsOwner = false)","return":true},
    {"from":"fe","to":"is","label":"GET /api/items/{fileId}/content  (file con trong folder Drive)"},
    {"from":"is","to":"perm","label":"IsItemSharedWithUserAsync | IsConnectionSharedWithUserAsync"},
    {"from":"perm","to":"is","label":"true (share đã Accepted)","return":true},
    {"from":"is","to":"conn","label":"GetByIdAsync(item.ConnectionId)"},
    {"from":"conn","to":"is","label":"connection của A","return":true},
    {"note":"BẮT BUỘC: if (conn.UserId != item.UserId) → 404\n(so với chủ item, KHÔNG so với người gọi)", "over":"is"},
    {"from":"is","to":"gw","label":"DownloadFile / Thumbnail (token của OWNER A)"},
    {"from":"gw","to":"google","label":"files.get"},
    {"from":"google","to":"gw","label":"nội dung file","return":true},
    {"from":"gw","to":"is","label":"stream","return":true},
    {"from":"is","to":"fe","label":"200 file content","return":true},
    {"from":"fe","to":"b","label":"hiển thị file (chỉ đọc — mọi thao tác ghi → 403)","return":true}
  ]
}
