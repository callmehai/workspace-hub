   "return": true
  },
  {
   "note": "user.Role == Admin && user.IsActive → BusinessRuleException ('Không thể khoá Admin')",
   "over": "as"
  },
  {
   "from": "as",
   "to": "repo",
   "label": "user.IsActive = !user.IsActive + SaveChangesAsync"
  },
  {
   "from": "repo",
   "to": "db",
   "label": "UPDATE Users"
  },
  {
   "from": "as",
   "to": "repo",
