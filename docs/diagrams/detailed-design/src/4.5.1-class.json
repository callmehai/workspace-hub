 "classes": [
  {
   "id": "fc",
   "name": "FoldersController",
   "stereotype": "controller",
   "col": 0,
   "row": 0,
   "color": "blue",
   "attrs": [
    "[Authorize]  /api/folders",
    "- _folderService: IFolderService",
    "- IValidator<InviteFolderShareRequest>",
    "- IValidator<UpdateFolderShareRequest>"
   ],
   "methods": [
    "+ POST {id}/shares → InviteShare",
    "+ GET  {id}/shares → GetShares",
    "+ PATCH {id}/shares/{shareId} → UpdateShareRole",
    "+ DELETE {id}/shares/{shareId} → RevokeShare",
    "+ GET  shared-with-me → GetSharedWithMe",
    "+ POST shares/{shareId}/accept | decline",
    "+ DELETE {id}/leave → LeaveFolder"
   ]
  },
  {
   "id": "ifs",
   "name": "IFolderService",
   "stereotype": "interface",
   "col": 1,
   "row": 0,
   "color": "purple",
   "methods": [
    "+ InviteShareAsync(folderId, requestingUserId, req, ct)",
    "+ GetSharesForFolderAsync(folderId, requestingUserId, ct)",
    "+ UpdateShareRoleAsync(folderId, shareId, userId, req, ct)",
    "+ RevokeShareAsync(folderId, shareId, userId, ct)",
    "+ GetFoldersSharedWithMeAsync(userId, ct)",
    "+ AcceptShareAsync(shareId, userId, ct)",
    "+ DeclineShareAsync(shareId, userId, ct)",
    "+ LeaveFolderAsync(folderId, userId, ct)"
   ]
  },
  {
   "id": "dto",
   "name": "DTOs",
   "stereotype": "record",
   "col": 2,
   "row": 0,
   "color": "grey",
   "attrs": [
    "InviteFolderShareRequest(FriendUserId, Permission)",
    "UpdateFolderShareRequest(Permission)",
    "FolderShareDto(ShareId, FolderId, User, Permission,",
    "  Status, CreatedAt, AcceptedAt)",
    "SharedFolderDto(ShareId, FolderId, FolderName,",
    "  OwnerUserId, OwnerName, Permission, Status, SharedAt)"
   ]
  },
  {
   "id": "exc",
   "name": "Exceptions → HTTP",
   "stereotype": "cross-cutting",
   "col": 3,
   "row": 0,
   "color": "red",
   "attrs": [
    "ForbiddenException(\"Chỉ Owner mới được chia sẻ\") → 403",
    "ForbiddenException(SharedViewerReadOnly) → 403",
    "ConflictException(\"Folder đã được chia sẻ\") → 409",
    "BusinessRuleException(\"chỉ share cho bạn bè\") → 400",
    "NotFoundException → 404 (che tồn tại)"
   ]
  },
  {
   "id": "fs",
   "name": "FolderService",
   "stereotype": "service",
   "col": 0,
   "row": 1,
   "color": "green",
   "attrs": [
    "- _folderRepo: IFolderRepository",
    "- _itemRepo: IItemRepository",
    "- _friendships: IFriendshipRepository",
    "- _notifications: INotificationService"
   ],
   "methods": [
    "+ InviteShareAsync: Owner-only → phải là bạn bè",
    "   (FriendshipStatus.Accepted) → chống share trùng",
    "   → FolderShare{ AcceptedAt = null } (pending)",
    "+ AcceptShareAsync: AcceptedAt = UtcNow",
    "- MapShareToDto(share)",
    "- SendShareNotificationSafeAsync(...)  // best-effort"
   ]
  },
  {
   "id": "is",
   "name": "ItemService",
   "stereotype": "service",
   "col": 1,
   "row": 1,
   "color": "green",
   "methods": [
    "+ GetItemsAsync: folder không thuộc user →",
    "   GetShareByFolderAndUserAsync → chưa Accepted",
    "   ⇒ trả PagedResult RỖNG (không 403)",
    "   → query theo folder.OwnerId (targetOwnerId)",
    "- CanReadSharedAsync(item, userId, ct)",
    "- ThrowNoWriteAccessAsync(itemId, userId, ct)"
   ]
  },
  {
   "id": "dcs",
   "name": "DriveContentService",
   "stereotype": "service",
   "col": 2,
   "row": 1,
   "color": "green",
   "methods": [
    "- ResolveDriveItemAsync(itemId, userId, ct)",
    "   item không thuộc user → share-check:",
    "   IsItemSharedWithUserAsync  HOẶC",
    "   IsConnectionSharedWithUserAsync (file con)",
    "   → load Connection theo item.ConnectionId",
    "   → conn.UserId != item.UserId ⇒ 404",
    "   ⇒ gọi Google bằng token của OWNER"
   ]
  },
  {
   "id": "dss",
   "name": "DriveSharingService",
   "stereotype": "service",
   "col": 3,
   "row": 1,
   "color": "grey",
   "attrs": [
    "(share trên chính Google Drive — KHÁC share nội bộ)"
   ],
   "methods": [
    "+ ListPermissionsAsync / AddPermissionAsync",
    "+ UpdatePermissionAsync / RemovePermissionAsync",
    "+ SetLinkSharingAsync(...)",
    "- ResolveDriveItemAsync: OWNER-ONLY (không share-fallback)"
   ]
  },
  {
   "id": "frepo",
   "name": "IFolderRepository",
   "stereotype": "repository",
   "col": 0,
   "row": 2,
   "color": "orange",
   "methods": [
    "+ AddShareAsync / RemoveShare / GetShareByIdAsync",
    "+ GetSharesByFolderAsync(folderId, ct)",
    "+ GetSharesForUserAsync(userId, ct)",
    "+ GetShareByFolderAndUserAsync(folderId, userId, ct)",
    "+ ShareExistsAsync(folderId, userId, ct)"
   ]
  },
  {
   "id": "perm",
   "name": "Share-check (trái tim phân quyền)",
   "stereotype": "repository",
   "col": 1,
   "row": 2,
   "color": "orange",
   "attrs": [
    "mọi truy vấn đều đòi fs.AcceptedAt != null"
   ],
   "methods": [
    "+ IsItemSharedWithUserAsync(itemId, userId, ct)",
    "    ĐỌC — Viewer + Editor",
    "+ IsItemSharedWithUserAsEditorAsync(itemId, userId, ct)",
    "    GHI provider — chỉ Editor",
    "+ IsConnectionSharedWithUserAsync(connId, userId, ct)",
    "    ĐỌC item Drive CON (không có ItemFolder riêng)",
    "+ IsConnectionSharedWithUserAsEditorAsync(...)"
   ]
  },
  {
   "id": "frrepo",
   "name": "IFriendshipRepository",
   "stereotype": "repository",
   "col": 2,
   "row": 2,
   "color": "orange",
   "methods": [
    "+ GetBetweenAsync(userA, userB, ct): Friendship?",
    "   Status phải = FriendshipStatus.Accepted",
    "   ⇒ chỉ share folder cho bạn bè trong app"
   ]
  },
  {
