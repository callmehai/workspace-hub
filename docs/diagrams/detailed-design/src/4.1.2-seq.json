{
  "title": "4.1.2 Sequence — Connection & OAuth (connect / callback / disconnect)",
  "participants": [
    {"id":"u","label":"User","actor":true},
    {"id":"fe","label":"Frontend SPA"},
    {"id":"cc","label":"ConnectionsController"},
    {"id":"cs","label":"ConnectionsService"},
    {"id":"cache","label":"Redis\n(IDistributedCache)"},
    {"id":"st","label":"IProviderStrategy\nGoogle | Jira"},
    {"id":"tc","label":"IOAuthTokenClient"},
    {"id":"prov","label":"Google / Atlassian"},
    {"id":"repo","label":"Connection /\nIntegration Repository"},
    {"id":"db","label":"SQL Server"}
  ],
  "messages": [
    {"note":"A. Initiate — POST /api/connections/oauth/start", "over":"cc"},
    {"from":"u","to":"fe","label":"bật service (Gmail / Calendar / Drive / Jira)"},
    {"from":"fe","to":"cc","label":"POST oauth/start {integrationKey, serviceType, redirectUri}"},
    {"from":"cc","to":"cs","label":"InitiateConnectionAsync(key, serviceType, redirectUri, userId)"},
    {"from":"cs","to":"repo","label":"GetByKeyAsync(integrationKey)"},
    {"from":"repo","to":"db","label":"SELECT Integrations"},
    {"from":"db","to":"repo","label":"integration","return":true},
    {"from":"repo","to":"cs","label":"integration (IsEnabled?)","return":true},
    {"note":"!IsEnabled → BusinessRuleException\nkhông có strategy → NotFoundException", "over":"cs"},
    {"from":"cs","to":"cache","label":"SetString(oauth:state:{state}, payload, TTL 10 phút)"},
    {"from":"cs","to":"st","label":"BuildAuthUrlAsync(clientId, redirectUri, state, serviceType)"},
    {"from":"st","to":"cs","label":"InitiateConnectionResult(authorizationUrl, state)","return":true},
    {"from":"cs","to":"cc","label":"result","return":true},
    {"from":"cc","to":"fe","label":"200 { authorizationUrl, state }","return":true},
    {"from":"fe","to":"prov","label":"redirect → màn hình consent (FULL scope của service)"},
    {"from":"prov","to":"fe","label":"redirect về app: ?code & state","return":true},

    {"note":"B. Callback — POST /api/connections/oauth/callback", "over":"cc"},
    {"from":"fe","to":"cc","label":"POST oauth/callback { code, state }"},
    {"from":"cc","to":"cs","label":"CompleteConnectionAsync(code, state, userId)"},
    {"from":"cs","to":"cache","label":"GetString(oauth:state:{state}) + RemoveAsync (one-time)"},
    {"from":"cache","to":"cs","label":"OAuthStatePayload","return":true},
    {"note":"state không tồn tại hoặc payload.UserId != userId\n→ CsrfException (403)", "over":"cs"},
    {"from":"cs","to":"st","label":"ExchangeCodeAsync(code, clientId, clientSecret, existingActiveAccountIds)"},
    {"from":"st","to":"tc","label":"PostFormAsync(tokenEndpoint, grant_type=authorization_code)"},
    {"from":"tc","to":"prov","label":"POST /token"},
    {"from":"prov","to":"tc","label":"access_token, refresh_token, scope, id_token","return":true},
    {"from":"tc","to":"st","label":"json","return":true},
    {"from":"st","to":"prov","label":"[Jira] GET /oauth/token/accessible-resources → chọn cloudId"},
    {"from":"st","to":"cs","label":"TokenExchangeResult(providerAccountId, grantedServices)","return":true},
    {"note":"ITokenProtector.Protect(accessToken / refreshToken)\n(ASP.NET Data Protection — không tự viết AES)", "over":"cs"},
    {"from":"cs","to":"repo","label":"loop mỗi grantedService: GetByUniqueKeyAsync(userId, provider, svc, accountId)"},
    {"from":"repo","to":"cs","label":"connection? (null = mới, có = reconnect)","return":true},
    {"from":"cs","to":"repo","label":"AddAsync(new Connection) hoặc cập nhật token (giữ CursorValue)"},
    {"from":"repo","to":"db","label":"INSERT / UPDATE Connections + SaveChangesAsync"},
    {"from":"cs","to":"cc","label":"CompleteConnectionResponse(integrationKey, accountId, connections)","return":true},
    {"from":"cc","to":"fe","label":"201 Created","return":true},
    {"note":"Sync lần đầu KHÔNG chạy trong callback:\n· on-demand khi GET /api/items (ConnectionHealthChecker)\n· hoặc bấm resync: POST /api/connections/{id}/sync", "over":"cs"},

    {"note":"C. Disconnect — DELETE /api/connections/{id}", "over":"cc"},
    {"from":"u","to":"fe","label":"Ngắt kết nối"},
    {"from":"fe","to":"cc","label":"DELETE /api/connections/{id}"},
    {"from":"cc","to":"cs","label":"DisconnectAsync(connectionId, userId)"},
    {"from":"cs","to":"repo","label":"GetByIdTrackedAsync(id)  → check UserId (ForbiddenException nếu lệch)"},
    {"from":"cs","to":"repo","label":"ExecuteInTransaction: DeleteByConnectionId(Items, ScheduledEmails) + Remove(connection)"},
    {"from":"repo","to":"db","label":"DELETE + SaveChangesAsync"},
    {"from":"cc","to":"fe","label":"204 No Content","return":true},
    {"from":"fe","to":"u","label":"cập nhật UI Integrations","return":true}
  ]
}
