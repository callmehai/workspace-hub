# ===== Secrets cho docker-compose.prod.yml =====
# Trên EC2:  cp deploy/.env.prod.example .env  → điền giá trị thật. File .env KHÔNG commit (đã gitignore).

# Domain đã trỏ A record về Elastic IP của EC2 (chỉ tên miền, KHÔNG kèm https://).
SITE_ADDRESS=app.yourdomain.com
# Email nhận cảnh báo Let's Encrypt (tuỳ chọn, để trống vẫn xin được cert).
ACME_EMAIL=you@example.com

# Mật khẩu SA của SQL Server — >=8 ký tự, đủ hoa/thường/số/ký tự đặc biệt.
MSSQL_SA_PASSWORD=ChangeMe_Strong#2026
# RAM cho SQL Server. Máy 2GB (Lightsail $10) để mặc định. Máy 4GB có thể nới:
#   MSSQL_MEMORY_LIMIT_MB=2048
#   MSSQL_MEM_LIMIT=2800m
# JWT ký token — >=32 ký tự ngẫu nhiên:  openssl rand -base64 48
JWT_SECRET=
# Secret cho cron endpoint:  openssl rand -base64 48
CRON_SECRET=

# Google OAuth (Google Cloud Console → Credentials → OAuth client).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Jira/Atlassian OAuth (developer.atlassian.com → OAuth 2.0 3LO app). Tuỳ chọn — để trống thì
# integration Atlassian bật nhưng connect Jira sẽ báo "Chưa cấu hình ClientId cho 'atlassian'".
# Callback URL của app Atlassian phải có: https://<SITE_ADDRESS>/oauth/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Twilio (tuỳ chọn) — để trống thì OTP đăng ký log ra console thay vì gửi SMS.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
