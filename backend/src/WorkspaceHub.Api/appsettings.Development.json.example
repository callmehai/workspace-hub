{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=WorkspaceHub;Trusted_Connection=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "workspace-hub-super-secret-key-change-in-production-32chars",
    "Issuer": "WorkspaceHub",
    "Audience": "WorkspaceHub",
    "ExpiresIn": 900,
    "RefreshExpiresIn": 604800
  },
  "Auth": {
    "CrossSiteCookies": false
  },
  "Sms": {
    "Twilio": {
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": ""
    }
  },
  "Google": {
    "RedirectUri": "http://localhost:5173/oauth/callback",
    "SignInRedirectUri": "http://localhost:5173/auth/google/callback"
  },
  "OAuth": {
    "google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    },
    "jira": {
      "ClientId": "YOUR_ATLASSIAN_CLIENT_ID",
      "ClientSecret": "YOUR_ATLASSIAN_CLIENT_SECRET"
    }
  }, "Cron": {
    "Secret": "dev-cron-secret-change-me",
    "AutoRun": false,
    "IntervalSeconds": 300,
    "SyncAutoRun": true,
    "SyncIntervalSeconds": 60
  },
  "R2": {
    "//": "Cloudflare R2 (SCRUM-75) cho avatar. Lấy từ Cloudflare Dashboard → R2. Hỏi lead để có giá trị dev thật.",
    "AccountId": "YOUR_R2_ACCOUNT_ID",
    "BucketName": "workspace-hub-assets",
    "PublicUrl": "https://pub-YOUR_HASH.r2.dev",
    "AccessKeyId": "YOUR_R2_ACCESS_KEY_ID",
    "SecretAccessKey": "YOUR_R2_SECRET_ACCESS_KEY"
  }
}
